diff --git a/src/mame/shared/segam1audio.cpp b/src/mame/shared/segam1audio.cpp
index e8971ea58d..b46ec0c335 100644
--- a/src/mame/shared/segam1audio.cpp
+++ b/src/mame/shared/segam1audio.cpp
@@ -14,17 +14,39 @@
 #include "machine/clock.h"
 #include "speaker.h"
 
+#include "cpu/m68000/m68000.h"
+
+// daytona-arcade-recomp oracle (M2TRACE_SNDLOG): every device access by the
+// sound 68000, tagged with the index of the instruction making it.
+namespace {
+template <typename T> T m2snd_logr(offs_t a, T v) {
+	if(g_m2snd_log) fprintf(g_m2snd_log, "r %llu %06x %x\n", (unsigned long long)(g_m2snd_insn - 1), a, unsigned(v));
+	return v;
+}
+void m2snd_logw(offs_t a, unsigned v) {
+	if(g_m2snd_log) fprintf(g_m2snd_log, "w %llu %06x %x\n", (unsigned long long)(g_m2snd_insn - 1), a, v);
+}
+}
+
 void segam1audio_device::segam1audio_map(address_map &map)
 {
 	map(0x000000, 0x03ffff).rom();
 	map(0x080000, 0x09ffff).rom().region("sndcpu", 0x20000); // mirror of upper ROM socket
-	map(0xc20000, 0xc20003).rw(m_uart, FUNC(i8251_device::read), FUNC(i8251_device::write)).umask16(0x00ff);
-	map(0xc40000, 0xc40007).rw(m_multipcm_1, FUNC(multipcm_device::read), FUNC(multipcm_device::write)).umask16(0x00ff);
-	map(0xc40012, 0xc40013).nopw();
-	map(0xc50000, 0xc50001).w(FUNC(segam1audio_device::m1_snd_mpcm_bnk1_w));
-	map(0xc60000, 0xc60007).rw(m_multipcm_2, FUNC(multipcm_device::read), FUNC(multipcm_device::write)).umask16(0x00ff);
-	map(0xc70000, 0xc70001).w(FUNC(segam1audio_device::m1_snd_mpcm_bnk2_w));
-	map(0xd00000, 0xd00007).rw(m_ym, FUNC(ym3438_device::read), FUNC(ym3438_device::write)).umask16(0x00ff);
+	map(0xc20000, 0xc20003).lrw8(
+		NAME([this](offs_t o) { return m2snd_logr<u8>(0xc20001 + o * 2, m_uart->read(o)); }),
+		NAME([this](offs_t o, u8 d) { m2snd_logw(0xc20001 + o * 2, d); m_uart->write(o, d); })).umask16(0x00ff);
+	map(0xc40000, 0xc40007).lrw8(
+		NAME([this](offs_t o) { return m2snd_logr<u8>(0xc40001 + o * 2, m_multipcm_1->read()); }),
+		NAME([this](offs_t o, u8 d) { m2snd_logw(0xc40001 + o * 2, d); m_multipcm_1->write(o, d); })).umask16(0x00ff);
+	map(0xc40012, 0xc40013).lw16(NAME([](offs_t o, u16 d, u16 m) { m2snd_logw(0xc40012, d & m); }));
+	map(0xc50000, 0xc50001).lw16(NAME([this](offs_t o, u16 d, u16 m) { m2snd_logw(0xc50000, d & m); m1_snd_mpcm_bnk1_w(d); }));
+	map(0xc60000, 0xc60007).lrw8(
+		NAME([this](offs_t o) { return m2snd_logr<u8>(0xc60001 + o * 2, m_multipcm_2->read()); }),
+		NAME([this](offs_t o, u8 d) { m2snd_logw(0xc60001 + o * 2, d); m_multipcm_2->write(o, d); })).umask16(0x00ff);
+	map(0xc70000, 0xc70001).lw16(NAME([this](offs_t o, u16 d, u16 m) { m2snd_logw(0xc70000, d & m); m1_snd_mpcm_bnk2_w(d); }));
+	map(0xd00000, 0xd00007).lrw8(
+		NAME([this](offs_t o) { return m2snd_logr<u8>(0xd00001 + o * 2, m_ym->read(o)); }),
+		NAME([this](offs_t o, u8 d) { m2snd_logw(0xd00001 + o * 2, d); m_ym->write(o, d); })).umask16(0x00ff);
 	map(0xf00000, 0xf0ffff).ram(); // real PCB actually has 2x 8kBx8-bit SRAMs (16kB total)
 }
 
