 #include "m68kcommon.h"
 
+#include <cstdio>
+
+// daytona-arcade-recomp oracle (M2TRACE_SNDLOG): the sound 68000's instruction
+// count and log, shared with the sound board's device handlers.
+extern u64 g_m2snd_insn;
